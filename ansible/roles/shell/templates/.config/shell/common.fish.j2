{% for name, value in shell_environment.items() if value != '' %}
set -gx {{ name }} "{{ value }}"
{% endfor %}

{% for path in shell_paths | reverse if path %}
fish_add_path --path "{{ path }}"
{% endfor %}

if status is-interactive
{% for name, value in shell_aliases.items() %}
    alias {{ name }} {{ value | quote }}
{% endfor %}
end
