#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != Darwin ]]; then
    echo "This command supports macOS only." >&2
    exit 1
fi

command -v jq >/dev/null || { echo "Install jq first." >&2; exit 1; }
directory="${1:-${XDG_CONFIG_HOME:-$HOME/.config}/shortcuts}"
installed="$(shortcuts list)"
temporary=""
trap 'if [[ -n "$temporary" ]]; then rm -rf "$temporary"; fi' EXIT

shopt -s nullglob
files=("$directory"/*.shortcut)
if [[ ${#files[@]} -eq 0 ]]; then
    echo "No shortcut files found in $directory." >&2
    exit 1
fi

for file in "${files[@]}"; do
    name="$(basename "$file" .shortcut)"
    binding="$(jq -er --arg name "$name" '.[$name] | select(type == "string" and length > 0)' "$directory/bindings.json")"

    if grep -Fxq -- "$name" <<< "$installed"; then
        echo "$name is already installed; keeping its existing actions."
    else
        if [[ ! -t 0 ]]; then
            echo "$name needs import confirmation. Run this command in a terminal." >&2
            exit 1
        fi
        if [[ -z "$temporary" ]]; then
            temporary="$(mktemp -d)"
        fi
        signed="$temporary/$name.shortcut"
        shortcuts sign --mode anyone --input "$file" --output "$signed"
        open "$signed"
        printf 'Confirm Add Shortcut for "%s", then press Enter here: ' "$name"
        read -r
        installed="$(shortcuts list)"
        if ! grep -Fxq -- "$name" <<< "$installed"; then
            echo "$name was not imported. No keyboard binding was applied." >&2
            exit 1
        fi
    fi

    defaults write -g NSUserKeyEquivalents -dict-add "$name" "$binding"
    echo "Applied keyboard binding for $name."
done

menu_bindings="$(jq -er 'to_entries[] | [.key, .value] | @tsv' "$directory/menu-bindings.json")"
while IFS=$'\t' read -r title binding; do
    menu_path="\\033${title//->/\\033}"
    defaults write -g NSUserKeyEquivalents -dict-add "\"$menu_path\"" "$binding"
    echo "Applied keyboard binding for $title."
done <<< "$menu_bindings"
