  ;; (no mappings)

  ;; === Collection: Vim - Apple Keyboard Shortcuts (enabled) ===
  ;; UUID: A1E0744C-66C1-4E69-8E68-DA2643765429
  ;; Description: Access familiar macOS shortcuts using Vim keys. Hold Leader + hjkl for arrows, y/p for copy/paste, u for undo, and more.
  esc
  grv  1    2    3    4    5    6    7    8    9    0    min  eql  bspc
  tab q   e   r   t   y   u   i   o   p   [   ]   \  
  a   d   f   g   h   j   k   l   ;   '   ret
  z x c v b n m , . /
  down  left  right up   

  ;; === Collection: Window Snapping (enabled) ===
  ;; UUID: F7A9B1C3-5D6E-8F0A-2B4C-6D8E0F2A4B6C
  ;; Description: Snap windows to edges/corners, move between displays and Spaces.
  ;; (no mappings)

