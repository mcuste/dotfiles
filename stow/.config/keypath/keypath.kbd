#|
================================================================================
ALIAS DEFINITIONS (defalias)
================================================================================
|#

(defalias
  ;; --- Layer Activators ---
  layer_nav_spc (tap-hold $tap-timeout 500 spc
    (multi
      (layer-while-held nav)
      (on-press-fakekey kp-layer-nav-enter tap)
      (on-release-fakekey kp-layer-nav-exit tap))
    (require-prior-idle 0))  ;; tap: spc  hold: Navigation layer
  layer_window_w (multi
    (on-press-fakekey kp-layer-window-enter tap)
    (one-shot-pause-processing 10)
    (one-shot-press 65000 (layer-while-held window))
  )  ;; tap: w  hold: Window layer
  layer_sym_s (multi
    (on-press-fakekey kp-layer-sym-enter tap)
    (one-shot-pause-processing 10)
    (one-shot-press 65000 (layer-while-held sym))
  )  ;; tap: s  hold: Sym layer

  ;; --- Tap-Hold Behaviors ---
  beh_base_caps (tap-hold-press $tap-timeout $hold-timeout
  (multi
      lctl
      lmet
      lalt
      lsft
    )(multi lctl lmet lalt lsft (layer-while-held launcher) (on-press-fakekey kp-layer-launcher-enter tap) (on-release-fakekey kp-layer-launcher-exit tap)))  ;; tap: hyper  hold: hyper
  beh_base_; (tap-hold-opposite-hand-release 190 ; lmet)  ;; tap: ;  hold: lmet
  beh_base_a (tap-hold-opposite-hand-release 190 a lmet)  ;; tap: a  hold: lmet
  beh_base_d (tap-hold-opposite-hand-release 190 d lctl)  ;; tap: d  hold: lctl
  beh_base_f (tap-hold-opposite-hand-release 190 f lsft)  ;; tap: f  hold: lsft
  beh_base_j (tap-hold-opposite-hand-release 190 j rsft)  ;; tap: j  hold: rsft
  beh_base_k (tap-hold-opposite-hand-release 190 k lctl)  ;; tap: k  hold: lctl
  beh_base_l (tap-hold-opposite-hand-release 190 l lalt)  ;; tap: l  hold: lalt
  beh_base_s (tap-hold-opposite-hand-release 190 s lalt)  ;; tap: s  hold: lalt

  ;; --- Modifier Forks ---
  fork_nav_a (fork right (multi lmet right) (lsft rsft))
  fork_nav_g (fork (multi lmet up) (multi lmet down) (lsft rsft))
  fork_nav_n (fork (multi lmet g) (multi lmet lsft g) (lsft rsft))
  fork_nav_d (fork (multi lalt bspc) pgdn (lctl rctl))
  fork_nav_u (fork (multi lmet z) pgup (lctl rctl))
  fork_nav_o (fork (macro M-right ret) (macro up M-right ret) (lsft rsft))

  ;; --- Action Aliases ---
  act_base_f3 (push-msg "system:mission-control")
  act_base_f4 (push-msg "system:spotlight")
  act_base_f5 (push-msg "system:dictation")
  act_base_f6 (push-msg "system:dnd")
  act_window_h (push-msg "window:left")
  act_window_l (push-msg "window:right")
  act_window_m (push-msg "window:maximize")
  act_window_c (push-msg "window:center")
  act_window_y (push-msg "window:top-left")
  act_window_u (push-msg "window:top-right")
  act_window_b (push-msg "window:bottom-left")
  act_window_n (push-msg "window:bottom-right")
  act_window_[ (push-msg "window:previous-display")
  act_window_] (push-msg "window:next-display")
  act_window_a (push-msg "window:previous-space")
  act_window_s (push-msg "window:next-space")
  act_window_z (push-msg "window:undo")
  act_launcher_a (push-msg "launch:com.apple.iCal")
  act_launcher_f (push-msg "launch:com.apple.finder")
  act_launcher_h (push-msg "open:youtube.com")
  act_launcher_j (push-msg "open:x.com")
  act_launcher_k (push-msg "launch:com.apple.MobileSMS")
  act_launcher_l (push-msg "open:linkedin.com")
  act_launcher_r (push-msg "open:reddit.com")
  act_launcher_z (push-msg "launch:us.zoom.xos")
  act_launcher_x (push-msg "launch:com.tinyspeck.slackmacgap")
  act_launcher_c (push-msg "launch:com.hnc.Discord")
  act_launcher_1 (push-msg "open:github.com")
  act_launcher_2 (push-msg "open:google.com")
)

