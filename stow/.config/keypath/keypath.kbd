;; Generated by KeyPath
;; Enabled: macOS Function Keys, Leader Key, Vim - Apple Keyboard Shortcuts, Window Snapping, Caps Lock Remap, Backup Caps Lock, Home Row Mods, Symbol, Fast Navigation, Quick Launcher

(defcfg
  process-unmapped-keys yes
  managed-repeat yes
  managed-repeat-unlisted no
  managed-repeat-delay 500
  managed-repeat-interval 30
  tap-hold-require-prior-idle 20
  concurrent-tap-hold yes
)
;; SAFETY: This configuration is auto-generated. Do not edit by hand.
;; SAFETY: Only explicitly enabled mappings are written to this file.
;; EMERGENCY EXIT: Hold Left Control + Space + Escape to force-quit Kanata
#|
================================================================================
TIMING VARIABLES
================================================================================
|#

(defvar
  tap-timeout   200
  hold-timeout  200
  chord-timeout  50
)

(defrepeat
  (left  150 20)
  (right  150 20)
  (up  150 20)
  (down  150 20)
  (bspc  210 20)
  (del  210 20)
)
(defhands
  (left q w e r t a s d f g z x c v b)
  (right y u i o p h j k l ; n m , . /))

#|
================================================================================
PHYSICAL KEYBOARD LAYOUT - DEFSRC
================================================================================
|#

(defsrc
  ;; === Primary Leader Key (System Preference) ===
  ;; Input: space
  ;; Activates: Navigation
          spc        

  ;; === Momentary Layer Switch ===
  ;; Input: w
  ;; Activates: Window
  w

  ;; === Momentary Layer Switch ===
  ;; Input: s
  ;; Activates: Sym
  s

  ;; === Collection: macOS Function Keys (enabled) ===
  ;; UUID: B8D6C8E4-2269-4C21-8C86-77D7A1722E01
  ;; Description: Preserves brightness, volume, media, and system control keys (F1-F12).
  f1  f2  f3  f4  f5  f6  f7  f8  f9  f10 f11 f12

  ;; === Collection: Leader Key (enabled) ===
  ;; UUID: A1B2C3D4-5E6F-7A8B-9C0D-1E2F3A4B5C6D
  ;; Description: Your Leader key is the starting key for KeyPath layers and sequences. It is Space by default. Choose Space, Caps Lock, Tab, or Backtick.
